					КонецЕсли;		
					ОбластьТекст.Параметры.УсловияОплатыТруда = "Работнику устанавливается " + ДанныеОбъекта.ФормаОплатыТруда + " " + ДанныеОбъекта.ОкладСумма + " (" + ДанныеОбъекта.ОкладСуммаПрописью +").";
				КонецЕсли;
			Иначе
				ОбластьТекст.Параметры.СрокВыплатыАванса = "25";
				ОбластьТекст.Параметры.СрокВыплатыЗарплаты = "10";
				ОбластьТекст.Параметры.РабочаяНеделя = "Работнику устанавливается рабочая неделя с предоставлением выходных дней по скользящему графику исходя из нормальной 40-часовой продолжительности рабочей недели.  График работ утверждается и доводится до сведения работника за 2 недели до начала работы.";
				ОбластьТекст.Параметры.УсловияОплатыТруда = "Работнику устанавливается " + ДанныеОбъекта.ФормаОплатыТруда + " " + ДанныеОбъекта.ОкладСумма + " (" + ДанныеОбъекта.ОкладСуммаПрописью +").";
			КонецЕсли;
			
			
			ВывестиОбластьТабличногоДокументаФрагментами(ОбластьТекст, ТабличныйДокумент);
			
			// Вывод данных в подписи договора
			// Выведем "ОбластьПодписи" в табличный документ по-строчно, с целью более полного заполнения формата страницы
			ОбластьПодписи.Параметры.Заполнить(ДанныеОбъекта);
			Если ИмяМакета = "ПФ_MXL_ТрудовойДоговор" или ИмяМакета = "ПФ_MXL_ТрудовойДоговор_Общий" Тогда
				
				// Для макета "ТрудовойДоговор" подписи всегда должны выводиться на отдельной странице			
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
				
			Иначе
				ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
			КонецЕсли;
			
			////// Вывод областей макета
			
			// Выведем нужное количество экземпляров (при печати комплектов)
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено И КомплектПечатиПоСсылке.Экземпляров > 1 Тогда
				ОбластьКопирования = ТабличныйДокумент.ПолучитьОбласть(НомерСтрокиНачало,,ТабличныйДокумент.ВысотаТаблицы);
				Для Итератор = 2 По КомплектПечатиПоСсылке.Экземпляров Цикл
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьКопирования);
				КонецЦикла;
			КонецЕсли;
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДоговора.РаботаСотрудник);
			
		КонецЦикла;
		
		// На всякий случай добавим еще сюда
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
		Возврат ТабличныйДокумент;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Функция СформироватьПечатнуюФормуТрудовойДоговорСменныйТКП(МассивОбъектов, ОбъектыПечати, КомплектыПечати, ПараметрыПечати, Макет) //18.05.21 АМ
		
		УстановитьПривилегированныйРежим(Истина);
		
		ВалютаСсылка = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.ИмяПараметровПечати = СтрЗаменить(Макет, "ПФ_MXL_", "ПАРАМЕТРЫ_ПЕЧАТИ_");
		ТабличныйДокумент.АвтоМасштаб = Истина;
		ТабличныйДокумент.ТолькоПросмотр = Истина;
		ТабличныйДокумент.ПолеСверху = 5;
		ТабличныйДокумент.ПолеСнизу = 5;
		ТабличныйДокумент.ПолеСлева = 10;
		ТабличныйДокумент.ПолеСправа = 5;
		ТабличныйДокумент.КоличествоЭкземпляров = 2;
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабличныйДокумент.РазмерКолонтитулаСверху = 4;
		ТабличныйДокумент.РазмерКолонтитулаСнизу = 4;
		
		ИмяМакета = Макет;
		
		Макет = ПолучитьМакет(Макет);
		
		ДанныеДляПечати = ПолучитьДанныеДляПечатнойФормыТрудовойДоговор(МассивОбъектов,Истина);
		
		ДанныеДоговоров = ДанныеДляПечати.ДанныеДоговоров;
		
		ДанныеФизЛицСотрудников = ДанныеДляПечати.ДанныеФизическихЛицСотрудников;
		
		ПервыйОбъект = Истина;
		Для каждого СтрокаДереваПервогоУровня Из ДанныеДоговоров Цикл
			
			ДанныеДетальныхЗаписей = СтрокаДереваПервогоУровня.Строки[0];
			Если ДанныеДетальныхЗаписей.Строки.Количество() > 0 Тогда
				ДанныеДоговора = ДанныеДетальныхЗаписей.Строки[0];
			Иначе
				ДанныеДоговора = ДанныеДетальныхЗаписей;
			КонецЕсли;
			
			//Для печати комплектов
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено Тогда
				КомплектПечатиПоСсылке = КомплектыПечати.Найти(ДанныеДоговора.РаботаСотрудник,"Ссылка");
				Если КомплектПечатиПоСсылке = Неопределено Тогда
					КомплектПечатиПоСсылке = КомплектыПечати[0];
				КонецЕсли;
				Если КомплектПечатиПоСсылке.Экземпляров = 0 Тогда
					Продолжить
				КонецЕсли;
			КонецЕсли;
			
			Если Не ПервыйОбъект Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйОбъект      = Ложь;
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			////// Заполнение данных объекта
			
			ДанныеОбъекта = Новый Структура;
			
			// Длительность основного отпуска
			ПараметрыПредметаИсчисления = ", , , , , , , , 0";
			ДлительностьОсновногоОтпуска = ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаПраваНаОтпускКоличествоДнейОбщегоОтпуска), ДанныеДоговора.РаботаПраваНаОтпускКоличествоДнейОбщегоОтпуска, 0);
			ДлительностьОсновногоОтпускаПрописью = "";
			ДлительностьОсновногоОтпускаПрописью = НРег(ЧислоПрописью(ОКР(ДлительностьОсновногоОтпуска), "Л=ru_RU;НП=Ложь;НД=Ложь", ПараметрыПредметаИсчисления));
			
			// Сумма оклада (тарифная ставка)		
			ФормаОплатыТруда = ?(СтрНайти(ДанныеДоговора.РаботаОплатаТрудаНачисление.ФормулаРасчета,"ТарифнаяСтавкаЧасовая")>0,"повременно-премиальная система оплаты труда: часовая тарифная ставка в размере","месячный должностной оклад в размере");		
			ОкладСумма = ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаОплатаТрудаЗначениеОсновногоПоказателя), ДанныеДоговора.РаботаОплатаТрудаЗначениеОсновногоПоказателя , ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаОплатаТрудаРазмер), ДанныеДоговора.РаботаОплатаТрудаРазмер, 0));
			ОкладСуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ОкладСумма, ВалютаСсылка);
			
			ТекущиеДанныеФизЛицаСотрудника = ПолучитьСтрокуТаблицы(ДанныеФизЛицСотрудников, Новый Структура("Сотрудник", ДанныеДоговора.РаботаСотрудник));
			
			ДополнитьДанныеОбъектаИнформациейОбОрганизации(ДанныеОбъекта, Неопределено, ДанныеДоговора.РаботаДатаПриема, ТекущиеДанныеФизЛицаСотрудника);
			
			КадровыеДанныеФизическихЛиц = КадровыйУчет.КадровыеДанныеФизическихЛиц(Ложь, ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо, "ДокументСерия, ДокументНомер, ДокументДатаВыдачи, ДокументКемВыдан", ДанныеДоговора.РаботаДатаПриема);
			ТекущиеКадровыеДанныеФизическихЛиц = ПолучитьСтрокуТаблицы(КадровыеДанныеФизическихЛиц, Новый Структура("ФизическоеЛицо", ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо));
			
			КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, ДанныеДоговора.РаботаСотрудник, "КлассУсловийТруда, ГрафикРаботы");
			ТекущиеКадровыеДанныеСотрудников = ПолучитьСтрокуТаблицы(КадровыеДанныеСотрудников, Новый Структура("Сотрудник", ДанныеДоговора.РаботаСотрудник));
			
			ДанныеОбъекта.Вставить("ДоговорНомер",                         ДанныеДоговора.РаботаТрудовойДоговорНомерНаПечать);
			ДанныеОбъекта.Вставить("ДоговорДата",                          СтрокаДоговора(?(ЗначениеЗаполнено(ДанныеДоговора.РаботаТрудовойДоговорДатаОформления), ДанныеДоговора.РаботаТрудовойДоговорДатаОформления, Дата(1,1,1))));
			ДанныеОбъекта.Вставить("ДатаПриема",                           СтрокаДоговора(?(ЗначениеЗаполнено(ДанныеДоговора.РаботаДатаПриема), ДанныеДоговора.РаботаДатаПриема, Дата(1,1,1))));
			ДанныеОбъекта.Вставить("ИспытательныйСрокМесяцев",             СтрокаДоговора(ДанныеДоговора.РаботаТрудовойДоговорДлительностьИспытательногоСрока,, Истина, ));
			ДанныеОбъекта.Вставить("ДлительностьОсновногоОтпускаПрописью", СтрокаДоговора(ПервоеСловоСЗаглавной(ДлительностьОсновногоОтпускаПрописью)));
			ДанныеОбъекта.Вставить("ДлительностьОсновногоОтпуска",         СтрокаДоговора(ДлительностьОсновногоОтпуска,, Истина, ));
			ДанныеОбъекта.Вставить("ОкладСумма",                           СтрокаДоговора(ФормированиеПечатныхФорм.ФорматСумм(ОкладСумма, ВалютаСсылка, "0")));
			ДанныеОбъекта.Вставить("ОкладСуммаПрописью",                   СтрокаДоговора(ОкладСуммаПрописью));
			ДанныеОбъекта.Вставить("ОрганизацияГородФактическогоАдреса",   СтрокаДоговора(ДанныеДоговора.РаботаОрганизацияГородФактическогоАдреса));
			ДанныеОбъекта.Вставить("Подразделение",                        СтрокаДоговора(ДанныеДоговора.РаботаПодразделениеНаПечать.Наименование)); // Ничего не остается, кроме как обратиться через точку к наименованию, так как типовая функция возвращает Подразделение в виде справочника ссылки
			ДанныеОбъекта.Вставить("КлассУсловийТруда",                    СтрокаДоговора(ТекущиеКадровыеДанныеСотрудников.КлассУсловийТруда));
			
			ДанныеОбъекта.Вставить("Сотрудник",                  ДанныеДоговора.РаботаСотрудник);
			ДанныеОбъекта.Вставить("СотрудникФИОПолные",         СтрокаДоговора(ДанныеДоговора.ЛичныеДанныеФИОФамилияИмяОтчество));
			ДанныеОбъекта.Вставить("СотрудникФИОИнициалы",       СтрокаДоговора(ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо)));
			ДанныеОбъекта.Вставить("СотрудникДолжность",         СтрокаДоговора(ДанныеДоговора.РаботаДолжность.Наименование)); // Ничего не остается, кроме как обратиться через точку к наименованию, так как у данного справочника ссылка в строку не преобразовуется, а типовая функция возвращает Должность в виде справочника ссылки
			ДанныеОбъекта.Вставить("СотрудникДолжностьВНРег",    СтрокаДоговора(ДанныеДоговора.РаботаДолжность.Наименование, Истина));
			ДанныеОбъекта.Вставить("СотрудникСНИЛС",             СтрокаДоговора(ДанныеДоговора.ЛичныеДанныеСтраховойНомерПФР)); // СНИЛС - это "Страховой номер ПФР"
			ДанныеОбъекта.Вставить("СотрудникИменуемое",         ?(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоПол = Перечисления.ПолФизическогоЛица.Женский, "именуемая", "именуемый"));
			ДанныеОбъекта.Вставить("СотрудникДатаРождения",      СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоДатаРождения));
			ДанныеОбъекта.Вставить("СотрудникПаспортСерия",      СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументСерия));
			ДанныеОбъекта.Вставить("СотрудникПаспортНомер",      СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументНомер));
			ДанныеОбъекта.Вставить("СотрудникПаспортКемВыдан",   СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументКемВыдан));
			ДанныеОбъекта.Вставить("СотрудникПаспортДатаВыдачи", СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументДатаВыдачи));
			ДанныеОбъекта.Вставить("СотрудникАдресПоПрописке",   СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.АдресПоПрописке));
			ДанныеОбъекта.Вставить("СотрудникИНН",               СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоИНН));
			ДанныеОбъекта.Вставить("ТекущаяДата",   			 СтрокаДоговора(ТекущаяДатаСеанса()));
			ДанныеОбъекта.Вставить("ФормаОплатыТруда",   		 СтрокаДоговора(ФормаОплатыТруда));
			
			
			////// Заполнение данных объекта
			
			////// Вывод областей макета
			
			ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");			
			ОбластьТекст     = Макет.ПолучитьОбласть("Текст");	  		
			ОбластьПодписи   = Макет.ПолучитьОбласть("Подписи");
			
			// Вывод данных в заголовок договора
			ОбластьЗаголовок.Параметры.Заполнить(ДанныеОбъекта);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
			// Вывод данных в текст договора
			// Выведем "ОбластьТекст" в табличный документ фрагментами, с целью более полного заполнения формата страницы
			ОбластьТекст.Параметры.Заполнить(ДанныеОбъекта);
			
			//Если ТекущиеДанныеФизЛицаСотрудника.ОрганизацияИНН = "2130184747" и ДанныеДоговора.РаботаДатаПриема >= Дата("20191101") Тогда
			//	ОбластьТекст.Параметры.ОрганизацияАдресФактический = "429509, Чувашская Республика, сельское поселение Атлашевское, д.Кодеркасы, территория тепличный комплекс Новочебоксарский";	  						
			//КонецЕсли;		
			
			ОбластьТекст.Параметры.СрокВыплатыАванса = "29";
			ОбластьТекст.Параметры.СрокВыплатыЗарплаты = "14";				
			ОбластьТекст.Параметры.ГрафикРаботы = ТекущиеКадровыеДанныеСотрудников.ГрафикРаботы.Наименование;
			
			/////////////////////////////////////////////////////////
			КоличествоЧасов = 0; //Для получения количества часов по графику. Если 24 часа, то обед 2 часа, иначе 1 час
			Для Каждого СтрокаДанныхОРабочихЧасах из ТекущиеКадровыеДанныеСотрудников.ГрафикРаботы.ДанныеОРабочихЧасах Цикл
				Если СтрокаДанныхОРабочихЧасах.ВидВремени = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы") Тогда
					КоличествоЧасов = СтрокаДанныхОРабочихЧасах.Часов + КоличествоЧасов;
				КонецЕсли;
			КонецЦикла;
			
			Если КоличествоЧасов = 8 Тогда
				ОбластьТекст.Параметры.ЧасыОбеда = "2 часа";
			Иначе
				ОбластьТекст.Параметры.ЧасыОбеда = "1 час";
			КонецЕсли;
			/////////////////////////////////////////////////////////
			
			//10.12.2021
			//ОбластьТекст.Параметры.УсловияОплатыТруда = "Работнику устанавливается " + ДанныеОбъекта.ФормаОплатыТруда + " " + ДанныеОбъекта.ОкладСумма + " (" + ДанныеОбъекта.ОкладСуммаПрописью +"). и премия в соответствии с действующим Положением об оплате труда ООО ТК «Пермский».";
			ОбластьТекст.Параметры.УсловияОплатыТруда = "Работнику устанавливается сдельно-премиальная система оплаты труда. Сдельные расценки, нормы выработки и размер премии устанавливаются в соответствии с действующим Положением об оплате труда ООО ТК «Пермский».";
			
			
			
			ВывестиОбластьТабличногоДокументаФрагментами(ОбластьТекст, ТабличныйДокумент);
			
			// Вывод данных в подписи договора
			// Выведем "ОбластьПодписи" в табличный документ по-строчно, с целью более полного заполнения формата страницы
			ОбластьПодписи.Параметры.Заполнить(ДанныеОбъекта);
			//Если ИмяМакета = "ПФ_MXL_ТрудовойДоговор_ТКП" или ИмяМакета = "ПФ_MXL_ТрудовойДоговор_Общий_ТКП" Тогда
			//	
			//	// Для макета "ТрудовойДоговор" подписи всегда должны выводиться на отдельной странице			
			//	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			//	ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
			//	
			//Иначе
			ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
			//КонецЕсли;
			
			////// Вывод областей макета
			
			// Выведем нужное количество экземпляров (при печати комплектов)
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено И КомплектПечатиПоСсылке.Экземпляров > 1 Тогда
				ОбластьКопирования = ТабличныйДокумент.ПолучитьОбласть(НомерСтрокиНачало,,ТабличныйДокумент.ВысотаТаблицы);
				Для Итератор = 2 По КомплектПечатиПоСсылке.Экземпляров Цикл
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьКопирования);
				КонецЦикла;
			КонецЕсли;
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДоговора.РаботаСотрудник);
			
		КонецЦикла;
		
		// На всякий случай добавим еще сюда
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
		ТабличныйДокумент.НижнийКолонтитул.ТекстСправа = "[&НомерСтраницы]";
		ТабличныйДокумент.НижнийКолонтитул.Выводить = Истина;             
		
		
		Возврат ТабличныйДокумент;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Функция СформироватьПечатнуюФормуТрудовойДоговорОбщий(МассивОбъектов, ОбъектыПечати, КомплектыПечати, ПараметрыПечати, Макет) //9428 ASTRA ГайнаДИ AddOn Begin
		
		УстановитьПривилегированныйРежим(Истина);
		
		ВалютаСсылка = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.ИмяПараметровПечати = СтрЗаменить(Макет, "ПФ_MXL_", "ПАРАМЕТРЫ_ПЕЧАТИ_");
		ТабличныйДокумент.АвтоМасштаб = Истина;
		ТабличныйДокумент.ТолькоПросмотр = Истина;
		ТабличныйДокумент.ПолеСверху = 5;
		ТабличныйДокумент.ПолеСнизу = 5;
		ТабличныйДокумент.ПолеСлева = 10;
		ТабличныйДокумент.ПолеСправа = 5;
		ТабличныйДокумент.КоличествоЭкземпляров = 2;
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабличныйДокумент.РазмерКолонтитулаСверху = 4;
		ТабличныйДокумент.РазмерКолонтитулаСнизу = 4;
		
		ИмяМакета = Макет;
		
		Макет = ПолучитьМакет(Макет);
		
		ДанныеДляПечати = ПолучитьДанныеДляПечатнойФормыТрудовойДоговор(МассивОбъектов, Истина);
		
		ДанныеДоговоров = ДанныеДляПечати.ДанныеДоговоров;
		
		ДанныеФизЛицСотрудников = ДанныеДляПечати.ДанныеФизическихЛицСотрудников;
		
		ПервыйОбъект = Истина;
		Для каждого СтрокаДереваПервогоУровня Из ДанныеДоговоров Цикл
			
			ДанныеДетальныхЗаписей = СтрокаДереваПервогоУровня.Строки[0];
			Если ДанныеДетальныхЗаписей.Строки.Количество() > 0 Тогда
				ДанныеДоговора = ДанныеДетальныхЗаписей.Строки[0];
			Иначе
				ДанныеДоговора = ДанныеДетальныхЗаписей;
			КонецЕсли;
			
			//Для печати комплектов
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено Тогда
				КомплектПечатиПоСсылке = КомплектыПечати.Найти(ДанныеДоговора.РаботаСотрудник,"Ссылка");
				Если КомплектПечатиПоСсылке = Неопределено Тогда
					КомплектПечатиПоСсылке = КомплектыПечати[0];
				КонецЕсли;
				Если КомплектПечатиПоСсылке.Экземпляров = 0 Тогда
					Продолжить
				КонецЕсли;
			КонецЕсли;
			
			Если Не ПервыйОбъект Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйОбъект      = Ложь;
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			////// Заполнение данных объекта
			
			ДанныеОбъекта = Новый Структура;
			
			// Длительность основного отпуска
			ПараметрыПредметаИсчисления = ", , , , , , , , 0";
			ДлительностьОсновногоОтпуска = ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаПраваНаОтпускКоличествоДнейОбщегоОтпуска), ДанныеДоговора.РаботаПраваНаОтпускКоличествоДнейОбщегоОтпуска, 0);
			ДлительностьОсновногоОтпускаПрописью = "";
			ДлительностьОсновногоОтпускаПрописью = НРег(ЧислоПрописью(ОКР(ДлительностьОсновногоОтпуска), "Л=ru_RU;НП=Ложь;НД=Ложь", ПараметрыПредметаИсчисления));
			
			// Сумма оклада (тарифная ставка)		
			ФормаОплатыТруда = ?(СтрНайти(ДанныеДоговора.РаботаОплатаТрудаНачисление.ФормулаРасчета,"ТарифнаяСтавкаЧасовая")>0,"почасовая оплата труда из расчета","должностной оклад в размере");
			ОкладСумма = ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаОплатаТрудаЗначениеОсновногоПоказателя), ДанныеДоговора.РаботаОплатаТрудаЗначениеОсновногоПоказателя , ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаОплатаТрудаРазмер), ДанныеДоговора.РаботаОплатаТрудаРазмер, 0));
			ОкладСуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ОкладСумма, ВалютаСсылка);
			
			ТекущиеДанныеФизЛицаСотрудника = ПолучитьСтрокуТаблицы(ДанныеФизЛицСотрудников, Новый Структура("Сотрудник", ДанныеДоговора.РаботаСотрудник));
			
			ДополнитьДанныеОбъектаИнформациейОбОрганизации(ДанныеОбъекта, Неопределено, ДанныеДоговора.РаботаДатаПриема, ТекущиеДанныеФизЛицаСотрудника);
			
			КадровыеДанныеФизическихЛиц = КадровыйУчет.КадровыеДанныеФизическихЛиц(Ложь, ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо, "ДокументСерия, ДокументНомер, ДокументДатаВыдачи, ДокументКемВыдан", ДанныеДоговора.РаботаДатаПриема);
			ТекущиеКадровыеДанныеФизическихЛиц = ПолучитьСтрокуТаблицы(КадровыеДанныеФизическихЛиц, Новый Структура("ФизическоеЛицо", ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо));
			
			КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, ДанныеДоговора.РаботаСотрудник, "КлассУсловийТруда");
			ТекущиеКадровыеДанныеСотрудников = ПолучитьСтрокуТаблицы(КадровыеДанныеСотрудников, Новый Структура("Сотрудник", ДанныеДоговора.РаботаСотрудник));
			
			ДанныеОбъекта.Вставить("ДоговорНомер",                         ДанныеДоговора.РаботаТрудовойДоговорНомерНаПечать);
			ДанныеОбъекта.Вставить("ДоговорДата",                          СтрокаДоговора(?(ЗначениеЗаполнено(ДанныеДоговора.РаботаТрудовойДоговорДатаОформления), ДанныеДоговора.РаботаТрудовойДоговорДатаОформления, Дата(1,1,1))));
			ДанныеОбъекта.Вставить("ДатаПриема",                           СтрокаДоговора(?(ЗначениеЗаполнено(ДанныеДоговора.РаботаДатаПриема), ДанныеДоговора.РаботаДатаПриема, Дата(1,1,1))));
			ДанныеОбъекта.Вставить("ИспытательныйСрокМесяцев",             СтрокаДоговора(ДанныеДоговора.РаботаТрудовойДоговорДлительностьИспытательногоСрока,, Истина, ));
			ДанныеОбъекта.Вставить("ДлительностьОсновногоОтпускаПрописью", СтрокаДоговора(ПервоеСловоСЗаглавной(ДлительностьОсновногоОтпускаПрописью)));
			ДанныеОбъекта.Вставить("ДлительностьОсновногоОтпуска",         СтрокаДоговора(ДлительностьОсновногоОтпуска,, Истина, ));
			ДанныеОбъекта.Вставить("ОкладСумма",                           СтрокаДоговора(ФормированиеПечатныхФорм.ФорматСумм(ОкладСумма, ВалютаСсылка, "0")));
			ДанныеОбъекта.Вставить("ОкладСуммаПрописью",                   СтрокаДоговора(ОкладСуммаПрописью));
			ДанныеОбъекта.Вставить("ОрганизацияГородФактическогоАдреса",   СтрокаДоговора(ДанныеДоговора.РаботаОрганизацияГородФактическогоАдреса));
			ДанныеОбъекта.Вставить("Подразделение",                        СтрокаДоговора(ДанныеДоговора.РаботаПодразделениеНаПечать.Наименование)); // Ничего не остается, кроме как обратиться через точку к наименованию, так как типовая функция возвращает Подразделение в виде справочника ссылки
			ДанныеОбъекта.Вставить("КлассУсловийТруда",                    СтрокаДоговора(ТекущиеКадровыеДанныеСотрудников.КлассУсловийТруда));
			
			ДанныеОбъекта.Вставить("Сотрудник",                  ДанныеДоговора.РаботаСотрудник);
			ДанныеОбъекта.Вставить("СотрудникФИОПолные",         СтрокаДоговора(ДанныеДоговора.ЛичныеДанныеФИОФамилияИмяОтчество));
			ДанныеОбъекта.Вставить("СотрудникФИОИнициалы",       СтрокаДоговора(ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо)));
			ДанныеОбъекта.Вставить("СотрудникДолжность",         СтрокаДоговора(ДанныеДоговора.РаботаДолжность.Наименование)); // Ничего не остается, кроме как обратиться через точку к наименованию, так как у данного справочника ссылка в строку не преобразовуется, а типовая функция возвращает Должность в виде справочника ссылки
			ДанныеОбъекта.Вставить("СотрудникДолжностьВНРег",    СтрокаДоговора(ДанныеДоговора.РаботаДолжность.Наименование, Истина));
			ДанныеОбъекта.Вставить("СотрудникСНИЛС",             СтрокаДоговора(ДанныеДоговора.ЛичныеДанныеСтраховойНомерПФР)); // СНИЛС - это "Страховой номер ПФР"
			ДанныеОбъекта.Вставить("СотрудникИменуемое",         ?(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоПол = Перечисления.ПолФизическогоЛица.Женский, "именуемая", "именуемый"));
			ДанныеОбъекта.Вставить("СотрудникДатаРождения",      СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоДатаРождения));
			ДанныеОбъекта.Вставить("СотрудникПаспортСерия",      СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументСерия));
			ДанныеОбъекта.Вставить("СотрудникПаспортНомер",      СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументНомер));
			ДанныеОбъекта.Вставить("СотрудникПаспортКемВыдан",   СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументКемВыдан));
			ДанныеОбъекта.Вставить("СотрудникПаспортДатаВыдачи", СтрокаДоговора(ТекущиеКадровыеДанныеФизическихЛиц.ДокументДатаВыдачи));
			ДанныеОбъекта.Вставить("СотрудникАдресПоПрописке",   СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.АдресПоПрописке));
			ДанныеОбъекта.Вставить("СотрудникИНН",               СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоИНН));
			ДанныеОбъекта.Вставить("ТекущаяДата",   			 СтрокаДоговора(ТекущаяДатаСеанса()));
			ДанныеОбъекта.Вставить("ФормаОплатыТруда",   		 СтрокаДоговора(ФормаОплатыТруда));
			
			
			////// Заполнение данных объекта
			
			////// Вывод областей макета
			
			ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");			
			ОбластьТекст     = Макет.ПолучитьОбласть("Текст");	  		
			ОбластьПодписи   = Макет.ПолучитьОбласть("Подписи");
			
			// Вывод данных в заголовок договора
			ОбластьЗаголовок.Параметры.Заполнить(ДанныеОбъекта);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
			// Вывод данных в текст договора
			// Выведем "ОбластьТекст" в табличный документ фрагментами, с целью более полного заполнения формата страницы
			ОбластьТекст.Параметры.Заполнить(ДанныеОбъекта);
			
			ОбластьТекст.Параметры.РабочаяНеделя = "пятидневная рабочая неделя с восьмичасовым рабочим днем.";
			Если ТекущиеДанныеФизЛицаСотрудника.ОрганизацияИНН = "2130184747" И ДанныеДоговора.РаботаДатаПриема >= Дата("20191101") Тогда
				//ОбластьТекст.Параметры.ОрганизацияАдресФактический = "429509, Чувашская Республика, сельское поселение Атлашевское, д.Кодеркасы, территория тепличный комплекс Новочебоксарский";	  						
				
				Если ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицоПол = Перечисления.ПолФизическогоЛица.Женский Тогда
					ОбластьТекст.Параметры.РабочаяНеделя = "пятидневная 36-часовая рабочая неделя.";
				Иначе
					ОбластьТекст.Параметры.РабочаяНеделя = "пятидневная рабочая неделя с восьмичасовым рабочим днем.";	
				КонецЕсли;		
			КонецЕсли;
			
			//Изменения с 31.01.2020:
			//1. Изменения в п.1.4
			//2. Изменения в п.3.2
			Если ТекущиеДанныеФизЛицаСотрудника.ОрганизацияИНН = "2130184747" И ДанныеДоговора.РаботаДатаПриема >= Дата("20200131") Тогда
				ОбластьТекст.Параметры.УсловияТруда = "Условия труда на рабочем месте Работника относятся к допустимым (2-й класс), выполняемая Работником по настоящему договору работа не относится к работе с тяжелыми, вредными и (или) опасными условиями труда. Рабочее место соответствует государственным требованиям охраны труда.";
				ОбластьТекст.Параметры.ВремяНачалоОкончанияРабот = "3.2. Время начала и окончания работы, время перерыва на обед, а также выходные дни  устанавливаются Правилами внутреннего трудового распорядка.";
			Иначе
				ОбластьТекст.Параметры.УсловияТруда = "На момент заключения трудового договора рабочее место не оценено. Оценка будет произведена в течение 12 месяцев, после чего условия труда будут доведены до Работника.";
				ОбластьТекст.Параметры.ВремяНачалоОкончанияРабот = "3.2. Время начала и окончания работы, время перерыва на обед устанавливаются Правилами внутреннего трудового распорядка.";
			КонецЕсли;
			
			//Изменения с 26.05.2020:
			//1. Изменения в п.4.2
			Если ТекущиеДанныеФизЛицаСотрудника.ОрганизацияИНН = "2130184747" И ДанныеДоговора.РаботаДатаПриема >= Дата("20200501") Тогда
				ОбластьТекст.Параметры.СрокВыплатыАванса = "29";
				ОбластьТекст.Параметры.СрокВыплатыЗарплаты = "14";
			Иначе
				ОбластьТекст.Параметры.СрокВыплатыАванса = "25";
				ОбластьТекст.Параметры.СрокВыплатыЗарплаты = "10";
			КонецЕсли;
			
			
			ВывестиОбластьТабличногоДокументаФрагментами(ОбластьТекст, ТабличныйДокумент);
			
			// Вывод данных в подписи договора
			// Выведем "ОбластьПодписи" в табличный документ по-строчно, с целью более полного заполнения формата страницы
			ОбластьПодписи.Параметры.Заполнить(ДанныеОбъекта);
			Если ИмяМакета = "ПФ_MXL_ТрудовойДоговор" или ИмяМакета = "ПФ_MXL_ТрудовойДоговор_Общий" Тогда
				
				// Для макета "ТрудовойДоговор" подписи всегда должны выводиться на отдельной странице			
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
				
			Иначе
				ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
			КонецЕсли;
			
			////// Вывод областей макета
			
			// Выведем нужное количество экземпляров (при печати комплектов)
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено И КомплектПечатиПоСсылке.Экземпляров > 1 Тогда
				ОбластьКопирования = ТабличныйДокумент.ПолучитьОбласть(НомерСтрокиНачало,,ТабличныйДокумент.ВысотаТаблицы);
				Для Итератор = 2 По КомплектПечатиПоСсылке.Экземпляров Цикл
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьКопирования);
				КонецЦикла;
			КонецЕсли;
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДоговора.РаботаСотрудник);
			
		КонецЦикла;
		
		// На всякий случай добавим еще сюда
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
		Возврат ТабличныйДокумент;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Функция СформироватьПечатнуюФормуТрудовойДоговорОбщийТКП(МассивОбъектов, ОбъектыПечати, КомплектыПечати, ПараметрыПечати, Макет) //18.05.21 АМ
		
		УстановитьПривилегированныйРежим(Истина);
		
		ВалютаСсылка = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.ИмяПараметровПечати = СтрЗаменить(Макет, "ПФ_MXL_", "ПАРАМЕТРЫ_ПЕЧАТИ_");
		ТабличныйДокумент.АвтоМасштаб = Истина;
		ТабличныйДокумент.ТолькоПросмотр = Истина;
		ТабличныйДокумент.ПолеСверху = 5;
		ТабличныйДокумент.ПолеСнизу = 5;
		ТабличныйДокумент.ПолеСлева = 10;
		ТабличныйДокумент.ПолеСправа = 5;
		ТабличныйДокумент.КоличествоЭкземпляров = 2;
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабличныйДокумент.РазмерКолонтитулаСверху = 4;
		ТабличныйДокумент.РазмерКолонтитулаСнизу = 4;
		
		ИмяМакета = Макет;
		
		Макет = ПолучитьМакет(Макет);
		
		ДанныеДляПечати = ПолучитьДанныеДляПечатнойФормыТрудовойДоговор(МассивОбъектов, Истина);
		
		ДанныеДоговоров = ДанныеДляПечати.ДанныеДоговоров;
		
		ДанныеФизЛицСотрудников = ДанныеДляПечати.ДанныеФизическихЛицСотрудников;
		
		ПервыйОбъект = Истина;
		Для каждого СтрокаДереваПервогоУровня Из ДанныеДоговоров Цикл
			
			ДанныеДетальныхЗаписей = СтрокаДереваПервогоУровня.Строки[0];
			Если ДанныеДетальныхЗаписей.Строки.Количество() > 0 Тогда
				ДанныеДоговора = ДанныеДетальныхЗаписей.Строки[0];
			Иначе
				ДанныеДоговора = ДанныеДетальныхЗаписей;
			КонецЕсли;
			
			//Для печати комплектов
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено Тогда
				КомплектПечатиПоСсылке = КомплектыПечати.Найти(ДанныеДоговора.РаботаСотрудник,"Ссылка");
				Если КомплектПечатиПоСсылке = Неопределено Тогда
					КомплектПечатиПоСсылке = КомплектыПечати[0];
				КонецЕсли;
				Если КомплектПечатиПоСсылке.Экземпляров = 0 Тогда
					Продолжить
				КонецЕсли;
			КонецЕсли;
			
			Если Не ПервыйОбъект Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйОбъект      = Ложь;
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			////// Заполнение данных объекта
			
			ДанныеОбъекта = Новый Структура;
			
			// Длительность основного отпуска
			ПараметрыПредметаИсчисления = ", , , , , , , , 0";
			ДлительностьОсновногоОтпуска = ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаПраваНаОтпускКоличествоДнейОбщегоОтпуска), ДанныеДоговора.РаботаПраваНаОтпускКоличествоДнейОбщегоОтпуска, 0);
			ДлительностьОсновногоОтпускаПрописью = "";
			ДлительностьОсновногоОтпускаПрописью = НРег(ЧислоПрописью(ОКР(ДлительностьОсновногоОтпуска), "Л=ru_RU;НП=Ложь;НД=Ложь", ПараметрыПредметаИсчисления));
			
			// Сумма оклада (тарифная ставка)		
			ФормаОплатыТруда = ?(СтрНайти(ДанныеДоговора.РаботаОплатаТрудаНачисление.ФормулаРасчета,"ТарифнаяСтавкаЧасовая")>0,"почасовая оплата труда из расчета","месячный должностной оклад в размере");
			ОкладСумма = ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаОплатаТрудаЗначениеОсновногоПоказателя), ДанныеДоговора.РаботаОплатаТрудаЗначениеОсновногоПоказателя , ?(ЗначениеЗаполнено(ДанныеДоговора.РаботаОплатаТрудаРазмер), ДанныеДоговора.РаботаОплатаТрудаРазмер, 0));
			ОкладСуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ОкладСумма, ВалютаСсылка);
			
			ТекущиеДанныеФизЛицаСотрудника = ПолучитьСтрокуТаблицы(ДанныеФизЛицСотрудников, Новый Структура("Сотрудник", ДанныеДоговора.РаботаСотрудник));
			
			ДополнитьДанныеОбъектаИнформациейОбОрганизации(ДанныеОбъекта, Неопределено, ДанныеДоговора.РаботаДатаПриема, ТекущиеДанныеФизЛицаСотрудника);
			
			КадровыеДанныеФизическихЛиц = КадровыйУчет.КадровыеДанныеФизическихЛиц(Ложь, ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо, "ДокументСерия, ДокументНомер, ДокументДатаВыдачи, ДокументКемВыдан", ДанныеДоговора.РаботаДатаПриема);
			ТекущиеКадровыеДанныеФизическихЛиц = ПолучитьСтрокуТаблицы(КадровыеДанныеФизическихЛиц, Новый Структура("ФизическоеЛицо", ТекущиеДанныеФизЛицаСотрудника.ФизическоеЛицо));
			
			КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, ДанныеДоговора.РаботаСотрудник, "КлассУсловийТруда");
			ТекущиеКадровыеДанныеСотрудников = ПолучитьСтрокуТаблицы(КадровыеДанныеСотрудников, Новый Структура("Сотрудник", ДанныеДоговора.РаботаСотрудник));
			
			ДанныеОбъекта.Вставить("ДоговорНомер",                         ДанныеДоговора.РаботаТрудовойДоговорНомерНаПечать);
			ДанныеОбъекта.Вставить("ДоговорДата",                          СтрокаДоговора(?(ЗначениеЗаполнено(ДанныеДоговора.РаботаТрудовойДоговорДатаОформления), ДанныеДоговора.РаботаТрудовойДоговорДатаОформления, Дата(1,1,1))));
			ДанныеОбъекта.Вставить("ДатаПриема",                           СтрокаДоговора(?(ЗначениеЗаполнено(ДанныеДоговора.РаботаДатаПриема), ДанныеДоговора.РаботаДатаПриема, Дата(1,1,1))));
			ДанныеОбъекта.Вставить("ИспытательныйСрокМесяцев",             СтрокаДоговора(ДанныеДоговора.РаботаТрудовойДоговорДлительностьИспытательногоСрока,, Истина, ));
			ДанныеОбъекта.Вставить("ДлительностьОсновногоОтпускаПрописью", СтрокаДоговора(ПервоеСловоСЗаглавной(ДлительностьОсновногоОтпускаПрописью)));
			ДанныеОбъекта.Вставить("ДлительностьОсновногоОтпуска",         СтрокаДоговора(ДлительностьОсновногоОтпуска,, Истина, ));
			ДанныеОбъекта.Вставить("ОкладСумма",                           СтрокаДоговора(ФормированиеПечатныхФорм.ФорматСумм(ОкладСумма, ВалютаСсылка, "0")));
			ДанныеОбъекта.Вставить("ОкладСуммаПрописью",                   СтрокаДоговора(ОкладСуммаПрописью));
