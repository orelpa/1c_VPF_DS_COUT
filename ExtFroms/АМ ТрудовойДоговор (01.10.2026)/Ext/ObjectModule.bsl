			// Выведем "ОбластьПодписи" в табличный документ по-строчно, с целью более полного заполнения формата страницы  
			
			//ТокмаковАМ     
			Если ИмяМакета = "ПФ_MXL_ДополнительноеСоглашениеКТрудовомуДоговоруСуммаДолжность" Тогда 		   
				ДанныеОбъекта.Вставить("ТекущаяДата", "1 сентября 2023 г.");       
				//	ГолубеваКК 13.10.2025  	 + Орёл П.А 14.10.2025
			ИначеЕсли  ИмяМакета = "ПФ_MXL_ДополнительноеСоглашениеКТрудовомуДоговоруИндексация" И ДанныеДоговора.РаботаОрганизацияИНН = "5921034316" ИЛИ ДанныеДоговора.РаботаОрганизацияИНН = "1108023823"
				
				Тогда     
				ДанныеОбъекта.Вставить("ТекущаяДата", "01 октября 2026 г.");      
			//	ГолубеваКК 13.10.2025  
           	Иначе
				// ++ бит_п_Новоселов А.И. 06.02.2025 #0000027509	 + ГолубеваКК 13.10.2025
				Если ДанныеДоговора.РаботаОрганизацияИНН = "5921034316" тогда
					ОбластьТекст.Параметры.ТекущаяДата = "01 октября 2026 г.";
				Иначе
					ОбластьТекст.Параметры.ТекущаяДата = Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");  
				// -- бит_п_Новоселов А.И. 06.02.2025   + ГолубеваКК 13.10.2025
				КонецЕсли;				
			КонецЕсли; 	

			ОбластьПодписи.Параметры.Заполнить(ДанныеОбъекта);
			
			//ТокмаковАМ

			
			ОбластьПодписи.Параметры.Заполнить(ДанныеОбъекта);
			Если ИмяМакета = "ПФ_MXL_ТрудовойДоговор" или ИмяМакета = "ПФ_MXL_ТрудовойДоговор_Общий" Тогда
				
				// Для макета "ТрудовойДоговор" подписи всегда должны выводиться на отдельной странице			
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
				
			Иначе
				ВывестиОбластьТабличногоДокументаФрагментами(ОбластьПодписи, ТабличныйДокумент);
			КонецЕсли;      
			
						
				
			
			////// Вывод областей макета
			
			// Выведем нужное количество экземпляров (при печати комплектов)
			Если КомплектыПечати <> Неопределено И КомплектыПечати.Колонки.Найти("Ссылка") <> Неопределено И КомплектПечатиПоСсылке.Экземпляров > 1 Тогда
				ОбластьКопирования = ТабличныйДокумент.ПолучитьОбласть(НомерСтрокиНачало,,ТабличныйДокумент.ВысотаТаблицы);
				Для Итератор = 2 По КомплектПечатиПоСсылке.Экземпляров Цикл
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьКопирования);
				КонецЦикла;
			КонецЕсли;
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДоговора.РаботаСотрудник);
			
		КонецЦикла;
		
		// На всякий случай добавим еще сюда
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
		Возврат ТабличныйДокумент;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Функция ПолучитьДанныеДляПечатнойФормыТрудовойДоговор(МассивОбъектов, ПечатьИзПриказаОПриеме = Ложь) //9428 ASTRA ГайнаДИ AddOn Begin
		
		ДанныеДляПечати = Новый Структура;
		
		////// Данные договоров ////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
		ИмяОтчета                = "Отчет.ПечатнаяФормаТрудовойДоговорМикропредприятий";
		ПутьКВариантуОтчета      = "Отчет.ПечатнаяФормаТрудовойДоговорМикропредприятий.ТрудовойДоговорМикропредприятий";
		ПутьКМакетуПечатнойФормы = "ОбщийМакет.ПФ_MXL_ТрудовойДоговорМикропредприятий";
		ИмяМакетаПечатнойФормы   = "ПФ_MXL_ТрудовойДоговорМикропредприятий";
		КлючВарианта             = "ТрудовойДоговорМикропредприятий";
		
		ОбъектОтчета = ОбщегоНазначения.ОбъектПоПолномуИмени(ИмяОтчета);
		
		НастройкиОтчетаКД = Неопределено;
		ПользовательскиеНастройкиКД = Неопределено;
		
		ЗарплатаКадрыОтчеты.ИнициализироватьНастройкиОтчета(ОбъектОтчета, "", КлючВарианта, НастройкиОтчетаКД, ПользовательскиеНастройкиКД);
		
		Если НастройкиОтчетаКД = Неопределено Тогда
			НастройкиОтчетаКД = ОбъектОтчета.СхемаКомпоновкиДанных.ВариантыНастроек[КлючВарианта].Настройки;
		КонецЕсли;
		
		ОбъектОтчета.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчетаКД);
		Если ТипЗнч(ПользовательскиеНастройкиКД) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
			ОбъектОтчета.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(ПользовательскиеНастройкиКД);
		КонецЕсли;
		
		////
		//ЗарплатаКадрыОтчеты.УстановитьПараметрОтбора(ОбъектОтчета, МассивОбъектов);
		Если ПечатьИзПриказаОПриеме Тогда 
			Если ТипЗнч(МассивОбъектов[0]) = Тип("СправочникСсылка.Сотрудники") Тогда
				
				ПечатаемыеСсылки = Новый Массив;
				КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(Истина, МассивОбъектов, "ПриказОПриеме");
				Для Каждого Сотрудник Из МассивОбъектов Цикл
					
					СтрокаДанных = КадровыеДанные.Найти(Сотрудник, "Сотрудник");
					Если СтрокаДанных <> Неопределено И ЗначениеЗаполнено(СтрокаДанных.ПриказОПриеме) Тогда
						ПечатаемыеСсылки.Добавить(СтрокаДанных.ПриказОПриеме);
					Иначе
						ПечатаемыеСсылки.Добавить(Сотрудник);
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			ЗарплатаКадрыОтчеты.УстановитьПараметрОтбора(ОбъектОтчета, ПечатаемыеСсылки);
		Иначе 
			ЗарплатаКадрыОтчеты.УстановитьПараметрОтбора(ОбъектОтчета, МассивОбъектов);	
		КонецЕсли;
		////
		
		СписокОтборов = Новый Массив;
		
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(
		СписокОтборов, "СсылкаНаСотрудника", ВидСравненияКомпоновкиДанных.ВСписке, ОбщегоНазначенияКлиентСервер.СкопироватьМассив(МассивОбъектов));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Отбор", СписокОтборов);
		
		ВнешниеНаборыДанных = Отчеты.ПечатнаяФормаТрудовойДоговорМикропредприятий.ВнешниеНаборыДанных();
		
		РезультатКомпоновки = ЗарплатаКадрыОтчеты.РезультатКомпоновкиМакетаПечатнойФормы(ОбъектОтчета, , , ВнешниеНаборыДанных, ДополнительныеПараметры);
		
		ДанныеДоговоров = РезультатКомпоновки.ДанныеОтчета.Строки;
		
		ДанныеДляПечати.Вставить("ДанныеДоговоров", ДанныеДоговоров);
		
		////// Данные договоров ////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		Запрос.Текст = "ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	Сотрудники.ГоловнаяОрганизация КАК Организация,
		|	Сотрудники.ГоловнаяОрганизация.ОГРН КАК ОрганизацияОГРН,
		|	Сотрудники.ГоловнаяОрганизация.ИНН КАК ОрганизацияИНН,
		|	Сотрудники.ГоловнаяОрганизация.КПП КАК ОрганизацияКПП,
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ФизическоеЛицо.Пол КАК ФизическоеЛицоПол,
		|	Сотрудники.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН,
		|	Сотрудники.ФизическоеЛицо.СтраховойНомерПФР КАК ФизическоеЛицоСтраховойНомерПФР,
		|	Сотрудники.ФизическоеЛицо.ДатаРождения КАК ФизическоеЛицоДатаРождения
		|ПОМЕСТИТЬ ДанныеФизЛицСотрудников
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка В(&МассивОбъектов)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Сотрудники.ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеФизЛицСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ФизическиеЛицаКонтактнаяИнформация.Представление КАК АдресПоПрописке
		|ПОМЕСТИТЬ КИФизЛицСотрудников
		|ИЗ
		|	ДанныеФизЛицСотрудников КАК ДанныеФизЛицСотрудников
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
		|		ПО ДанныеФизЛицСотрудников.ФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
		|ГДЕ
		|	ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
		|	И ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотрудники.Сотрудник КАК Сотрудник,
		|	Сотрудники.Организация КАК Организация,
		|	Сотрудники.ОрганизацияОГРН КАК ОрганизацияОГРН,
		|	Сотрудники.ОрганизацияИНН КАК ОрганизацияИНН,
		|	Сотрудники.ОрганизацияКПП КАК ОрганизацияКПП,
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ФизическоеЛицоПол КАК ФизическоеЛицоПол,
		|	Сотрудники.ФизическоеЛицоИНН КАК ФизическоеЛицоИНН,
		|	Сотрудники.ФизическоеЛицоСтраховойНомерПФР КАК ФизическоеЛицоСтраховойНомерПФР,
		|	Сотрудники.ФизическоеЛицоДатаРождения КАК ФизическоеЛицоДатаРождения,
		|	КИФизЛицСотрудников.АдресПоПрописке КАК АдресПоПрописке
		|ИЗ
		|	ДанныеФизЛицСотрудников КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ КИФизЛицСотрудников КАК КИФизЛицСотрудников
		|		ПО Сотрудники.ФизическоеЛицо = КИФизЛицСотрудников.ФизическоеЛицо";
		
		ДанныеФизическихЛицСотрудников = Запрос.Выполнить();
		
		ДанныеДляПечати.Вставить("ДанныеФизическихЛицСотрудников", ДанныеФизическихЛицСотрудников.Выгрузить());
		ДанныеДляПечати.ДанныеФизическихЛицСотрудников.Индексы.Добавить("Сотрудник");
		
		//ДанныеДляПечатиКадровогоПриказа = КадровыйУчет.СформироватьЗапросДляТ1(МассивОбъектов).Выгрузить();
		//КадровыеДанныеСотрудников = КадровыйУчет.КадровыеДанныеСотрудников(Ложь, МассивОбъектов, "Организация, Подразделение, Должность, ТарифнаяСтавка");	
		//КадровыеДанныеФизическихЛиц = КадровыйУчет.КадровыеДанныеФизическихЛиц(Ложь, СписокФизическихЛиц, "ДокументСерия, ДокументНомер, ДокументДатаВыдачи, ДокументКемВыдан");
		
		Возврат ДанныеДляПечати; 
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Процедура ДополнитьДанныеОбъектаИнформациейОбОрганизации(ДанныеОбъекта, Организация, ДатаПолученияИнформации, ТекущиеДанныеФизЛицаСотрудника) //9428 ASTRA ГайнаДИ AddOn Begin
		
		// Сведения об организации
		
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			Организация = ТекущиеДанныеФизЛицаСотрудника.Организация;
		КонецЕсли;
		
		СведенияОбОрганизации = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, ДатаПолученияИнформации);  
		
		ТаблицаОтветственныеЛицаОрганизации = ОтветственныеЛицаСервер.ПолучитьТаблицуОтветственныхЛицПоОтбору(Новый Структура("Организация, Дата", Организация, ДатаПолученияИнформации));
		МассивОтветственныеЛицаОрганизации = Новый Массив;
		Если ТаблицаОтветственныеЛицаОрганизации.Количество() Тогда
			МассивОтветственныеЛицаОрганизации = ТаблицаОтветственныеЛицаОрганизации.НайтиСтроки(Новый Структура("ОтветственноеЛицо", Перечисления.ОтветственныеЛицаОрганизаций.Руководитель));
		КонецЕсли;
		
		Если МассивОтветственныеЛицаОрганизации.Количество() Тогда
			ОтветственныеЛицаОрганизации = МассивОтветственныеЛицаОрганизации[0];
		Иначе
			ОтветственныеЛицаОрганизации = Новый Структура;
			Для каждого ТекКолонка Из ТаблицаОтветственныеЛицаОрганизации.Колонки Цикл
				Если ТекКолонка.Имя = "ФизическоеЛицо" Тогда
					ОтветственныеЛицаОрганизации.Вставить(ТекКолонка.Имя, Справочники.ФизическиеЛица.ПустаяСсылка());
				ИначеЕсли ТекКолонка.Имя = "ПравоПодписиПоДоверенности" Тогда
					ОтветственныеЛицаОрганизации.Вставить(ТекКолонка.Имя, Ложь);
				Иначе
					ОтветственныеЛицаОрганизации.Вставить(ТекКолонка.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		РуководительОрганизации = ОтветственныеЛицаОрганизации.ФизическоеЛицо;
		ДолжностьРуководителяОрганизации = ОтветственныеЛицаОрганизации.Должность;
		
		ПолРуководителяОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РуководительОрганизации, "Пол");
		ПолРуководителяОрганизацииЧислом = ?(Перечисления.ПолФизическогоЛица.Женский = ПолРуководителяОрганизации, 2, 1);
		
		ДанныеОбъекта.Вставить("Организация", Организация);
		ДанныеОбъекта.Вставить("ОрганизацияНаименованиеСокращенное", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "СокращенноеНаименование")));
		ДанныеОбъекта.Вставить("ОрганизацияОфициальноеНаименование", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ОфициальноеНаименование")));
		
		ДанныеОбъекта.Вставить("ОрганизацияАдресФактический", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ФактическийАдрес")));
		ДанныеОбъекта.Вставить("ОрганизацияАдресЮридический", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ЮридическийАдрес")));
		ДанныеОбъекта.Вставить("ОрганизацияИНН", СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ОрганизацияИНН));
		ДанныеОбъекта.Вставить("ОрганизацияКПП", СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ОрганизацияКПП));
		ДанныеОбъекта.Вставить("ОрганизацияОГРН", СтрокаДоговора(ТекущиеДанныеФизЛицаСотрудника.ОрганизацияОГРН));
		
		ДанныеОбъекта.Вставить("НомерСчета", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "НомерСчета")));
		ДанныеОбъекта.Вставить("КоррСчет", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "КоррСчет")));
		ДанныеОбъекта.Вставить("Банк", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "Банк")));
		ДанныеОбъекта.Вставить("БИК", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "БИК")));
		ДанныеОбъекта.Вставить("Телефоны", СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "Телефоны")));
		ДанныеОбъекта.Вставить("ЭлектроннаяПочта",СтрокаДоговора(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ЭлектроннаяПочта")));
		
		
		
		//1 - Именительный, 2 - Родительный, 3 - Дательный, 4 - Винительный, 5 - Творительный, 6 - Предложный.
		// У Агроменеджмента чтобы получить официальное наименование организации в Дательном падеже для ПФ "Согласие на обработку персональных данных"
		// нужно было заполнить регистр слов исключений, но так как у некоторых организаций в официальных наименованиях были одинаковые слова, но в разных регистрах,
		// то и на выходе мы получали одинаковые слова, правильно просклоненные, но в разных регистрах, для решения этого вопроса было принято решение переводить все слова
		// в нижний регистр с заглавными буквами, а для этого нужно передать в функцию ASTRAПроцедурыСервер.Просклонять() параметр ФИО = Истина, в данном случае 
		// параметр ВНижнийРегистр = Ложь, чтобы функция не переводила слова исключения в нижний регистр, значения иметь не будет, так как все равно все слова будут переводиться
		// в нижний регистр и у каждого слова первая буква будет преобразовываться к заглавной
		ДанныеОбъекта.Вставить("ОрганизацияОфициальноеНаименованиеДПВсеСЗаглавной", СтрокаДоговора(ASTRAПроцедурыСервер.Просклонять(ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "ОфициальноеНаименование"), 3, 1, Истина, Ложь)));
		
		ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяИПСЗаглавной", СтрокаДоговора(ПервоеСловоСЗаглавной(ДолжностьРуководителяОрганизации))); 
		
		Если ТекущиеДанныеФизЛицаСотрудника.Организация.ГоловнаяОрганизация.ИНН = "1108023823" Тогда;
			ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяИПСЗаглавной", "Генеральный директор");
		КонецЕсли;

		
		ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяИП", СтрокаДоговора(ДолжностьРуководителяОрганизации, Истина));
		ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяРПСЗаглавной", СтрокаДоговора(ПервоеСловоСЗаглавной(ASTRAПроцедурыСервер.Просклонять(НРег(ДолжностьРуководителяОрганизации), 2, ПолРуководителяОрганизацииЧислом))));
		ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяРП", СтрокаДоговора(ASTRAПроцедурыСервер.Просклонять(НРег(ДолжностьРуководителяОрганизации), 2, ПолРуководителяОрганизацииЧислом)));
		ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяДПСЗаглавной", СтрокаДоговора(ПервоеСловоСЗаглавной(ASTRAПроцедурыСервер.Просклонять(НРег(ДолжностьРуководителяОрганизации), 3, ПолРуководителяОрганизацииЧислом))));
		ДанныеОбъекта.Вставить("ОрганизацияДолжностьРуководителяТП", СтрокаДоговора(ASTRAПроцедурыСервер.Просклонять(НРег(ДолжностьРуководителяОрганизации), 5, ПолРуководителяОрганизацииЧислом)));
		
		ДанныеОбъекта.Вставить("ОрганизацияФИОРуководителяРП", "");
		ФизическиеЛицаЗарплатаКадры.Просклонять(СтрокаДоговора(СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РуководительОрганизации, "Наименование"))), 2, ДанныеОбъекта.ОрганизацияФИОРуководителяРП, ПолРуководителяОрганизацииЧислом);
		
		ДанныеОбъекта.Вставить("ОрганизацияФИОРуководителяДП", "");
		ФизическиеЛицаЗарплатаКадры.Просклонять(СтрокаДоговора(СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РуководительОрганизации, "Наименование"))), 3, ДанныеОбъекта.ОрганизацияФИОРуководителяДП, ПолРуководителяОрганизацииЧислом);
		
		
		ДанныеОбъекта.Вставить("ОрганизацияФИОРуководителяИнициалыИП", СтрокаДоговора(ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(РуководительОрганизации),,, Истина));
		
		Если СведенияОбОрганизации.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо 
			ИЛИ СведенияОбОрганизации.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель 
			Тогда
			ДанныеОбъекта.Вставить("ОрганизацияИменуемое", ?(ПолРуководителяОрганизации = Перечисления.ПолФизическогоЛица.Женский, "именуемая", "именуемый"));
		Иначе
			ДанныеОбъекта.Вставить("ОрганизацияИменуемое", "именуемое");	
		КонецЕсли;
		
		ДанныеОбъекта.Вставить("ОрганизацияДействующее", ?(ПолРуководителяОрганизации = Перечисления.ПолФизическогоЛица.Женский, "действующей", "действующего"));
		ДанныеОбъекта.Вставить("ОрганизацияОснованиеДействия", ?(ОтветственныеЛицаОрганизации.ПравоПодписиПоДоверенности, СтрокаДоговора(ОтветственныеЛицаОрганизации.ОснованиеПраваПодписи, Истина), "Устава"));
		
	КонецПроцедуры //ASTRA ГайнаДИ AddOn End
	
	Процедура ВывестиОбластьТабличногоДокументаФрагментами(ОбластьМакета, ТабличныйДокумент) //9428 ASTRA ГайнаДИ AddOn Begin
		
		////Выведем область табличного документа 
		////с проверкой вывода в каретку драйвера печати
		//
		////Область помещается
		//Если ТабличныйДокумент.ПроверитьВывод(ОбластьМакета) Тогда
		//	ТабличныйДокумент.Вывести(ОбластьМакета);
		//	Возврат;
		//КонецЕсли;
		//
		//// Область не вместилась, попробуем вывести её фрагментами
		//НачалоОбласти = 1;
		//сч = 1;
		//Пока сч <= ОбластьМакета.ВысотаТаблицы Цикл
		//	
		//	ФрагментОбластиМакета = ОбластьМакета.ПолучитьОбласть(НачалоОбласти,, сч);
		//	Если ТабличныйДокумент.ПроверитьВывод(ФрагментОбластиМакета) Тогда
		//		//Фрагмент "влезает", пропускаем
		//		сч = сч + 1;
		//		Продолжить;
		//	КонецЕсли;
		
		//	//Фрагмент "не влез", получим фрагмент, на одну строку меньше
		//	ФрагментОбластиМакета = ОбластьМакета.ПолучитьОбласть(НачалоОбласти,, сч - 1);
		//	
		//	//Выведем фрагмент области табличного документа, влезающую на страницу
		//	ТабличныйДокумент.Вывести(ФрагментОбластиМакета);
		//	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		//	
		//	// Далее цикл начнется с текущего сч, так как здесь мы его не увеличиваем и на следующем листе снова будет проверяться
		//	// возможность вывода остатка области, потому что оставшаяся область теоретически может не влезть и на следующий лист
		//	
		//	НачалоОбласти = сч;
		//	
		//КонецЦикла;
		
		
		//Область помещается
		Если ТабличныйДокумент.ПроверитьВывод(ОбластьМакета) Тогда
			ТабличныйДокумент.Вывести(ОбластьМакета);
			Возврат;
		КонецЕсли;
		
		//Область не помещается, 
		//попробуем часть области вписать в страницу по-строчно,
		//чтобы избежать пустых мест на странице
		КоличествоСтрокОбласти = ОбластьМакета.ПолучитьРазмерОбластиДанныхПоВертикали();
		
		Б = 0;
		Пока Б < КоличествоСтрокОбласти Цикл
			Б = Б + 1;
			ФрагментОбластиМакета = ОбластьМакета.ПолучитьОбласть(1,, Б);
			Если ТабличныйДокумент.ПроверитьВывод(ФрагментОбластиМакета) Тогда
				//Фрагмент "влезает", пропускаем
				Продолжить;
			КонецЕсли;
			
			//Фрагмент "не влез", получим фрагмент, на одну строку меньше
			ФрагментОбластиМакета = ОбластьМакета.ПолучитьОбласть(1,, Б - 1);
			
			//Выведем фрагмент области табличного документа, влезающую на страницу
			ТабличныйДокумент.Вывести(ФрагментОбластиМакета);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			//Выведем оставшуюся часть области табличного документа
			//на следующую на страницу
			ОстатокОбластиМакета = ОбластьМакета.ПолучитьОбласть(Б,, КоличествоСтрокОбласти);
			ТабличныйДокумент.Вывести(ОстатокОбластиМакета);
			Прервать;
		КонецЦикла;
		
	КонецПроцедуры //ASTRA ГайнаДИ AddOn End
	
	Функция ТаблицаНачисленийСотрудниковПоВременнойТаблице(МенеджерВременныхТаблиц, ИмяВТСотрудникиПериоды, ИмяПоляПериод = "Период", ИмяПоляСотрудник = "Сотрудник", ИмяПоляДатаОкончания = "", ИспользоватьКраткиеПредставления = Истина, ВыводитьДенежныеПоказателиСВалютой = Ложь, ФормироватьСПериодичностьДень = Истина) Экспорт
	
	НачисленияСотрудников = Новый ТаблицаЗначений;
	НачисленияСотрудников.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	НачисленияСотрудников.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	НачисленияСотрудников.Колонки.Добавить("ТарифнаяСтавка", Новый ОписаниеТипов("Число"));
	НачисленияСотрудников.Колонки.Добавить("ОписаниеОклада", Новый ОписаниеТипов("Строка"));
	НачисленияСотрудников.Колонки.Добавить("Надбавка", Новый ОписаниеТипов("Строка"));         
	НачисленияСотрудников.Колонки.Добавить("ПоказательОкладТариф", Новый ОписаниеТипов("СправочникСсылка.ПоказателиРасчетаЗарплаты"));	
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьНачислениеЗарплаты") Тогда
		
		ОписанияНачислений = КадровыйУчет.ОписанияСоставаНачисленийПоВременнойТаблице(МенеджерВременныхТаблиц, ИмяВТСотрудникиПериоды, ИмяПоляПериод, ИмяПоляСотрудник, ИмяПоляДатаОкончания, ИспользоватьКраткиеПредставления, ВыводитьДенежныеПоказателиСВалютой, ФормироватьСПериодичностьДень);
		
		Для каждого ОписаниеСотрудника Из ОписанияНачислений Цикл
			
			Для каждого ОписаниеПериода Из ОписаниеСотрудника.Значение Цикл
				
				НоваяСтрока = НачисленияСотрудников.Добавить();
				
				НоваяСтрока.Сотрудник = ОписаниеСотрудника.Ключ;
				НоваяСтрока.Период = ОписаниеПериода.Ключ;
				НоваяСтрока.ТарифнаяСтавка = ОписаниеПериода.Значение.ОкладТариф;
				НоваяСтрока.ОписаниеОклада = ОписаниеПериода.Значение.ОписаниеОклада;
				НоваяСтрока.Надбавка = ОписаниеПериода.Значение.ОписаниеНадбавок;  
				НоваяСтрока.ПоказательОкладТариф = ОписаниеПериода.Значение.ПоказательОкладТариф;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НачисленияСотрудников;
	
КонецФункции

	//ТокмаковАМ
	Функция ПолучитьДолжностьСотрудника(Сотрудник);
	
	МассивСотрудников = Новый Массив;
	МассивСотрудников.Добавить(Сотрудник);
	ТЗСведения = КадровыйУчет.КадровыеДанныеСотрудников(Истина,МассивСотрудников,"Должность",ТекущаяДата());
	Если ТЗСведения.Количество()>0 Тогда
		Должность = ТЗСведения[0].Должность;
	Иначе
		Должность = ПредопределенноеЗначение("Справочник.Должности.ПустаяСсылка");
	КонецЕсли;
	Возврат Должность;
	
КонецФункции
	
	#КонецОбласти
	
	#Область Прочее
	
	Функция СтрокаДоговора(Знач Стр, ВНижнийРегистр = Ложь, КороткаяСтрока = Ложь, НеЗабиватьПодчеркиванием = Ложь) //9428 ASTRA ГайнаДИ AddOn Begin
		
		Если НЕ ЗначениеЗаполнено(Стр) Тогда
			Если ТипЗнч(Стр) = Тип("Дата") Тогда
				Возврат """___""_________20__г.";
			ИначеЕсли КороткаяСтрока Тогда
				Возврат "___";
			ИначеЕсли НеЗабиватьПодчеркиванием Тогда
				Возврат "";
			Иначе			
				Возврат "_________________";
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(Стр) = Тип("Дата") Тогда
			Результат = Формат(Стр, "ДФ='dd MMMM yyyy ""г.""'");
		Иначе
			Стр = СокрЛП(Стр);
			Если ВНижнийРегистр Тогда
				Стр = НРег(Стр);
			КонецЕсли;
			
			Если Найти(Врег(Стр), "УСТАВ") > 0 Тогда
				МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Стр, " ");
				
				МассивОбработанныхПодстрок = Новый Массив;
				Для каждого ТекПодСтрока Из МассивПодстрок Цикл
					ПодстрокаРезультат = "";
					Если Найти(Врег(ТекПодСтрока), "УСТАВ") > 0 Тогда
						ПодстрокаРезультат = ТРег(ТекПодСтрока);
						МассивОбработанныхПодстрок.Добавить(ПодстрокаРезультат);
					Иначе
						МассивОбработанныхПодстрок.Добавить(ТекПодСтрока);
					КонецЕсли;
				КонецЦикла;
				
				Стр = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивОбработанныхПодстрок, " ");
			КонецЕсли;
			
			Результат = Стр;
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Функция ПолучитьСтрокуТаблицы(Таблица, СтруктураПоиска) //9428 ASTRA ГайнаДИ AddOn Begin
		
		НайденныеСтроки = Таблица.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() Тогда
			СтрокаТаблицы = НайденныеСтроки[0];
		Иначе
			СтрокаТаблицы = Новый Структура;
			Для Каждого ТекКолонка Из Таблица.Колонки Цикл
				СтрокаТаблицы.Вставить(ТекКолонка.Имя);
			КонецЦикла;
		КонецЕсли;
		
		Возврат СтрокаТаблицы;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	Функция ПервоеСловоСЗаглавной(Стр) //9428 ASTRA ГайнаДИ AddOn Begin
		
		Если НЕ ЗначениеЗаполнено(Стр) Тогда
			Возврат Стр;
		КонецЕсли;
		
		ОбрабатываемаяСтрока = СокрЛП(Стр);
		
		ПерваяБукваВСтроке = Лев(ОбрабатываемаяСтрока, 1);
		
		ПерваяБукваВСтрокеВВРег = ВРег(ПерваяБукваВСтроке);
		
		ОбрабатываемаяСтрокаБезПервойБуквы = Прав(ОбрабатываемаяСтрока, СтрДлина(ОбрабатываемаяСтрока) - 1);
		
		ОбрабатываемаяСтрока = ПерваяБукваВСтрокеВВРег + ОбрабатываемаяСтрокаБезПервойБуквы;
		
		Возврат ОбрабатываемаяСтрока;
		
	КонецФункции //ASTRA ГайнаДИ AddOn End
	
	#КонецОбласти
	
	#Область Константы
	
	ИмяОбработки = Метаданные().Имя;
	Синоним		 = Метаданные().Синоним;
	Комментарий  = Метаданные().Комментарий;
	
	ОписаниеПечатныхФорм = Новый ТаблицаЗначений;
	ОписаниеПечатныхФорм.Колонки.Добавить("Макет");
	ОписаниеПечатныхФорм.Колонки.Добавить("МакетПредставление");
	ОписаниеПечатныхФорм.Колонки.Добавить("Назначение");
	
	#КонецОбласти
	
	#Область Назначения
	
	СписокНазначений = Новый СписокЗначений;
	СписокНазначений.Добавить("Справочник.Сотрудники");
	
	НоваяСтрока = ОписаниеПечатныхФорм.Добавить();
	НоваяСтрока.Макет = "ПФ_MXL_ТрудовойДоговор";
	НоваяСтрока.МакетПредставление = "Трудовой договор (режим сменный)";
	НоваяСтрока.Назначение = СписокНазначений;
	
	НоваяСтрока = ОписаниеПечатныхФорм.Добавить();
	НоваяСтрока.Макет = "ПФ_MXL_ТрудовойДоговорСрочныйУпаковщик";
	НоваяСтрока.МакетПредставление = "Трудовой договор (срочный) Упаковщик";
